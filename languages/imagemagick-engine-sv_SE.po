#~ msgstr "Optimera"

#~ msgid "Enable enhanced image engine"
#~ msgstr "Aktivera ImageMagick Engine"

#~ msgid "Handle sizes"
#~ msgstr "Hantera storlekar"

#~ msgid "Force resize"
#~ msgstr "Tvinga Omskalning"

